    {
      "type": "row",
      "id": 100,
      "title": "Health Status",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },

    {
      "type": "stat",
      "id": 1,
      "title": "Consecutive Failures",
      "description": "Worst consecutive failure streak across all partitions — primary alerting signal. Resets to 0 on any success.",
      "gridPos": { "x": 0, "y": 1, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "text": { "valueSize": 72 }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(canary_partition_consecutive_failures{host=~\"$host\"})",
          "refId": "A",
          "legendFormat": ""
        }
      ]
    },

    {
      "type": "gauge",
      "id": 2,
      "title": "Check Success Rate (5m)",
      "description": "Percentage of canary checks that succeeded in the last 5 minutes.",
      "gridPos": { "x": 6, "y": 1, "w": 5, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 80 },
              { "color": "green", "value": 95 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(canary_checks_total{result=\"success\",host=~\"$host\"}[5m])) / sum(rate(canary_checks_total{host=~\"$host\"}[5m])) * 100",
          "refId": "A",
          "legendFormat": ""
        }
      ]
    },

    {
      "type": "stat",
      "id": 3,
      "title": "Schema Registry Health (5m)",
