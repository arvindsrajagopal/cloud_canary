      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(canary_sr_checks_total{result=\"success\",host=~\"$host\"}[5m])) / sum(rate(canary_sr_checks_total{host=~\"$host\"}[5m])) * 100",
          "refId": "A",
          "legendFormat": ""
        }
      ]
    },

