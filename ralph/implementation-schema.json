{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "summary", "changed_files", "tests_added_or_updated", "tests_run", "assumptions", "blockers", "remaining_work"],
  "properties": {
    "status": {"type": "string", "enum": ["COMPLETE", "HUMAN_REQUIRED", "BLOCKED"]},
    "summary": {"type": "string", "maxLength": 2000},
    "changed_files": {"type": "array", "maxItems": 4, "items": {"type": "string", "maxLength": 500}},
    "tests_added_or_updated": {"type": "array", "maxItems": 30, "items": {"type": "string", "maxLength": 500}},
    "tests_run": {"type": "array", "maxItems": 30, "items": {"type": "string", "maxLength": 1000}},
    "assumptions": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 1000}},
    "blockers": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 1000}},
    "remaining_work": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 1000}}
  }
}
