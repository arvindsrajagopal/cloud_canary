{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "summary", "categories", "human_intervention"],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["PASS", "FAIL", "HUMAN_REQUIRED"]
    },
    "summary": {
      "type": "string",
      "maxLength": 2000
    },
    "human_intervention": {
      "type": "boolean"
    },
    "categories": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consistency",
        "security",
        "architecture",
        "performance",
        "best_practices",
        "specification_deviation"
      ],
      "properties": {
        "consistency": {"$ref": "#/$defs/category"},
        "security": {"$ref": "#/$defs/category"},
        "architecture": {"$ref": "#/$defs/category"},
        "performance": {"$ref": "#/$defs/category"},
        "best_practices": {"$ref": "#/$defs/category"},
        "specification_deviation": {"$ref": "#/$defs/category"}
      }
    }
  },
  "$defs": {
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "findings"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["PASS", "WARN", "FAIL"]
        },
        "findings": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["classification", "severity", "file", "line", "message", "recommendation", "future_task", "novelty_explanation"],
            "properties": {
              "classification": {
                "type": "string",
                "enum": ["BLOCKER_CURRENT_TASK", "INTRODUCED_REGRESSION", "FUTURE_TASK", "SPEC_GAP", "NON_BLOCKING_IMPROVEMENT"]
              },
              "severity": {
                "type": "string",
                "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
              },
              "file": {"type": "string", "maxLength": 500},
              "line": {"type": ["integer", "null"], "minimum": 1},
              "message": {"type": "string", "maxLength": 2000},
              "recommendation": {"type": "string", "maxLength": 2000},
              "future_task": {"type": ["string", "null"], "maxLength": 100},
              "novelty_explanation": {"type": ["string", "null"], "maxLength": 2000}
            }
          }
        }
      }
    }
  }
}
