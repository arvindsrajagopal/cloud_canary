# Copy this file to config.ini and fill in your Confluent Cloud credentials.
# Never commit config.ini — it is listed in .gitignore.

[kafka]
bootstrap.servers=pkc-xxxxx.region.provider.confluent.cloud:9092
security.protocol=SASL_SSL
sasl.mechanisms=PLAIN
sasl.username=YOUR_KAFKA_API_KEY
sasl.password=YOUR_KAFKA_API_SECRET

[schema_registry]
url=https://psrc-xxxxx.region.provider.confluent.cloud
basic.auth.user.info=SR_API_KEY:SR_API_SECRET

[app]
topic=cloud-canary
consumer.timeout.seconds=5
check.interval.seconds=15
partition.sync.interval.seconds=86400
sr.check.interval.seconds=60
warmup.checks=2

# Log topic — set enabled=true to publish all canary logs to Kafka for long-term retention.
# The topic is created automatically with the retention period below (default 7 days).
metrics.port=8000

# Log topic (optional) — set log.topic.enabled=true to publish logs to Kafka for long-term retention.
log.topic.enabled=false
log.topic=cloud-canary-logs
log.topic.retention.ms=604800000
